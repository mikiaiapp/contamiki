# --- CONFIGURACIÓN PRINCIPAL ---
# Tu clave de Google Gemini (Obtener en aistudio.google.com)
GEMINI_API_KEY=

# Clave secreta para firmar los tokens de sesión (Cámbiala por seguridad)
JWT_SECRET=

# Puerto del servidor (Por defecto 3000)
PORT=3000

# URL pública de la aplicación (Importante para los enlaces de los emails)
APP_URL=

# --- CONFIGURACIÓN DE CORREO (SMTP) ---
# NOTA: Para Gmail, usa una "Contraseña de Aplicación", no tu contraseña habitual.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
