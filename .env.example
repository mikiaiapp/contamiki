# --- CONFIGURACIÓN PRINCIPAL ---
# NOTA: Se recomienda configurar estas variables directamente en el archivo docker-compose.yml
# para tener un único punto de configuración al desplegar el contenedor.

# Clave secreta para firmar los tokens de sesión (Cámbiala por una cadena aleatoria y segura)
# JWT_SECRET=un_secreto_muy_seguro_y_largo_cambialo

# URL pública de la aplicación (Importante para que los enlaces de los emails funcionen correctamente)
# APP_URL=https://conta.mafede.i234.me

# --- CORREO (alta de usuarios, recuperar contraseña…) ---
# Opción A: servidor SMTP propio o de tu proveedor
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=…
# SMTP_PASS=…
# SMTP_FROM=…
# Opción B: servicio de correo central ya existente
# CENTRAL_EMAIL_URL=…
# CENTRAL_EMAIL_KEY=…
