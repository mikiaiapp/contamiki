# --- CONFIGURACIÓN PRINCIPAL ---
# Tu clave de Google Gemini (Obtener en aistudio.google.com)
# API_KEY=

# Clave secreta para firmar los tokens de sesión (Cámbiala por seguridad)
JWT_SECRET=

# URL pública de la aplicación (Importante para los enlaces de los emails)
APP_URL=

# --- CONFIGURACIÓN DE CORREO (SMTP LOCAL) ---
# NOTA: Si usas el CARTERO CENTRAL, puedes dejar esto vacío.
# Para Gmail, usa una "Contraseña de Aplicación", no tu contraseña habitual.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# --- CONFIGURACIÓN DE CARTERO CENTRAL (OPCIONAL) ---
# Si quieres usar un servidor central para todos los correos:
CENTRAL_EMAIL_URL=cartero.mafede.i234.me
CENTRAL_EMAIL_KEY=mikiaiapp
